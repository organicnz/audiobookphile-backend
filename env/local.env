# =============================================================================
# AUDIOBOOKPHILE — LOCAL ENVIRONMENT (single source of truth)
# =============================================================================
# This file is the ONLY env source for local development across the three
# repos. Do NOT create per-repo env files by hand — run the sync script:
#
#   ./scripts/sync-env.sh
#
# It generates:
#   ../audiobookphile-web/.env.local
#   ../audiobookphile-app/.maestro/.env
#   ./.env
#
# Secrets are NOT stored here. They live in:
#   - Vercel project env vars          (web production/preview)
#   - Supabase Vault                  (database secrets)
#   - Supabase Edge Function secrets  (function secrets)
#   - GitHub Actions secrets          (Maestro CI)
# Leave secret values blank in this file; fill them in the platform.

# --- Backend (Supabase CLI / local scripts) -------------------------------
# [backend]
SUPABASE_PROJECT_ID=iambzzclljayqdxkeepy
SUPABASE_ACCESS_TOKEN=
CRON_SECRET=
GITHUB_TOKEN=
B2_SECONDARY_KEY_ID=
B2_SECONDARY_APP_KEY=
B2_SECONDARY_ENDPOINT=
B2_SECONDARY_REGION=
B2_SECONDARY_BUCKET_NAME=
B2_TERTIARY_KEY_ID=
B2_TERTIARY_APP_KEY=
B2_TERTIARY_ENDPOINT=
B2_TERTIARY_REGION=
B2_TERTIARY_BUCKET_NAME=
ACTIVE_B2_TIER=

# --- Web (Next.js) ----------------------------------------------------------
# [web]
NEXT_PUBLIC_SUPABASE_URL=https://iambzzclljayqdxkeepy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SUPABASE_SERVICE_ROLE_KEY=

# --- Maestro E2E (iOS app) ----------------------------------------------------
# [maestro]
SERVER_URL=http://localhost:3000
TEST_EMAIL=
TEST_PASSWORD=
MAGIC_LINK_URL=
