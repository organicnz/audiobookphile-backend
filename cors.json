[
  {
    "corsRuleName": "allow-upload",
    "allowedOrigins": [
      "https://*",
      "http://*"
    ],
    "allowedHeaders": [
      "*"
    ],
    "allowedOperations": [
      "b2_upload_file",
      "b2_upload_part",
      "b2_download_file_by_id",
      "b2_download_file_by_name",
      "s3_delete",
      "s3_get",
      "s3_head",
      "s3_post",
      "s3_put"
    ],
    "exposeHeaders": [
      "ETag"
    ],
    "maxAgeSeconds": 3600
  }
]
